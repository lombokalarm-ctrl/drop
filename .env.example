# Pilih: sqlite atau mysql
DB_CONNECTION=sqlite

# Untuk SQLite
DB_DATABASE=storage/database.sqlite

# Untuk MySQL / MariaDB
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=drop
# DB_USERNAME=drop_user
# DB_PASSWORD=ganti-password-aman
# DB_CHARSET=utf8mb4

# Sumber data SQLite untuk migrasi ke MySQL
SQLITE_SOURCE_PATH=storage/database.sqlite
